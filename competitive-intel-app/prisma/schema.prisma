datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id                    String   @id @default(uuid())
  targetCompany         String
  threatScore           Float
  industryDomain        String
  executiveSummary      String
  swotAnalysis          String   // JSON string
  featureMatrix         String   // JSON string
  geoAudit              String?  // JSON string
  mermaidChart          String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DomainAudit {
  id                    String   @id @default(uuid())
  domain                String   @unique
  seoHealthScore        Float
  geoReadinessScore     Float
  pbnSpamRiskScore      Float
  aiBotsStatus          String   // JSON string
  schemaTypes           String   // JSON string
  createdAt             DateTime @default(now())
}

model CompetitorTrack {
  id                    String   @id @default(uuid())
  competitor            String
  changeType            String   // 'pricing_update', 'positioning_shift', 'feature_release'
  title                 String
  description           String
  riskLevel             String   // 'Low', 'Medium', 'High', 'Critical'
  pricingData           String?  // JSON string
  createdAt             DateTime @default(now())
}

model ScrapedContent {
  id                    String   @id @default(uuid())
  targetUrl             String
  engine                String   // 'firecrawl' or 'crawl4ai'
  contentMarkdown       String
  structuredJson        String?  // JSON string
  ragReadinessScore     Float?
  createdAt             DateTime @default(now())
}

model GptResearchReport {
  id                    String   @id @default(uuid())
  topic                 String
  reportMarkdown        String
  sourcesCount          Int
  citationSources       String   // JSON string
  createdAt             DateTime @default(now())
}
